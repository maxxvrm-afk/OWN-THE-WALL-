{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "https://fsaeujbldqjetfewovuy.supabase.co/functions/v1/seo-static?type=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://fsaeujbldqjetfewovuy.supabase.co/functions/v1/seo-static?type=sitemap"
    },
    {
      "source": "/",
      "destination": "https://fsaeujbldqjetfewovuy.supabase.co/functions/v1/site-loader"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}